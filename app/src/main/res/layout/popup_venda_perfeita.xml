<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparente">

    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:background="@color/backgroudcolor"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView43"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Legenda Venda Perfeita"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/PopupVendaPerfeita_BotaoFechar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_weight="0"
                android:background="@color/transparente"
                android:src="@drawable/ic_baseline_close_black_40" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="#D93830"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <CheckBox
                android:id="@+id/PopupVendaPerfeita_CheckboxConversao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#000000"
                android:clickable="false"
                android:text="Converta" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="#805D3C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <CheckBox
                android:id="@+id/PopupVendaPerfeita_CheckboxSKU"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#000"
                android:clickable="false"
                android:text="Adicione SKU's" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="#00BF63"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <CheckBox
                android:id="@+id/PopupVendaPerfeita_CheckboxTicketMedio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#000"
                android:clickable="false"
                android:text="Construa Ticket Médio" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="#FFDE59"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <CheckBox
                android:id="@+id/PopupVendaPerfeita_CheckboxDesconto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#000"
                android:clickable="false"
                android:text="Administre os Descontos e as Concessões" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="#019EE3"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <CheckBox
                android:id="@+id/PopupVendaPerfeita_CheckboxEntrega"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#000"
                android:clickable="false"
                android:text="Venda a Entrega Garantida" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>