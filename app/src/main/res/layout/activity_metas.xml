<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MetasActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/metas_appbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/metas_status_bar_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/primary_dark" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/metas_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/AppTheme.PopupOverlay"
            app:subtitleTextColor="@android:color/white"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/metas_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/metas_appbar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnDetalhesMeta"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_menu_ocorrencia" 
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFEB3B"/>
        </RelativeLayout>

        <!-- Inputs de Data (Movidos para cá) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Inicial"
                    android:textColor="#000000"/>

                <EditText
                    android:id="@+id/edtDataIni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="date"
                    android:hint="dd/mm/aaaa"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Final"
                    android:textColor="#000000"/>

                <EditText
                    android:id="@+id/edtDataFim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="date"
                    android:hint="dd/mm/aaaa"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Cabeçalho com Totais Animados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Venda Líquida"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <TextView
                        android:id="@+id/txtTotalVendaLiquida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Margem"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <TextView
                        android:id="@+id/txtTotalMargem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,00%"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comissão"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <TextView
                        android:id="@+id/txtTotalComissao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Premiação"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <TextView
                        android:id="@+id/txtTotalPremiacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pr. Acelerados"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <TextView
                        android:id="@+id/txtTotalPremiacaoAcelerados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnFaturamentoLinha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Venda por Linha"
            android:backgroundTint="#14c35a"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="Buscar"
            android:backgroundTint="@color/table_header"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TELA 1: TABELA DE METAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutLoadingTabela"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aguarde, calculando metas..."
                    android:layout_marginTop="8dp"
                    android:textColor="#000000"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtInfoGatilho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D80000"
                android:textSize="12sp"
                android:padding="8dp"
                android:visibility="gone"/>

            <HorizontalScrollView
                android:id="@+id/scrollTabela"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TableLayout
                    android:id="@+id/tabelaMetas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:background="#FFFFFF"
                    android:visibility="gone">

                    <!-- Header -->
                    <TableRow>
                        <TextView
                            android:text="Indicador"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:padding="12dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_header"/>
                        <TextView
                            android:text="Meta"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:padding="12dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_header"/>
                        <TextView
                            android:text="Realizado"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:padding="12dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_header"/>
                        <TextView
                            android:text="Ganho"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:padding="12dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_header"/>
                    </TableRow>

                    <!-- Row 1 -->
                    <TableRow>
                        <TextView
                            android:text="Pagamento à Vista"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center_vertical"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtMetaAvista"
                            android:text="45%"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtRealizadoAvista"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtGanhoAvista"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                    </TableRow>

                    <!-- Row 2 -->
                    <TableRow>
                        <TextView
                            android:text="Linhas positivadas"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center_vertical"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtMetaLinhas"
                            android:text="16"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtRealizadoLinhas"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtGanhoLinhas"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                    </TableRow>

                    <!-- Row 3 -->
                    <TableRow>
                        <TextView
                            android:text="Média SKU por Venda"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center_vertical"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtMetaSku"
                            android:text="4"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtRealizadoSku"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtGanhoSku"
                            android:text="R$ 200"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                    </TableRow>

                    <!-- Row 4 -->
                    <TableRow>
                        <TextView
                            android:text="Frete vendido (%)"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center_vertical"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtMetaFrete"
                            android:text="80%"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtRealizadoFrete"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtGanhoFrete"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                    </TableRow>

                    <!-- Row 5 -->
                    <TableRow>
                        <TextView
                            android:text="Vendido vs Margem"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center_vertical"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtMetaFaturamento"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtRealizadoFaturamento"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                        <TextView
                            android:id="@+id/txtGanhoFaturamento"
                            android:text="-"
                            android:textColor="#000000"
                            android:padding="10dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row"/>
                    </TableRow>

                </TableLayout>
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnProximo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:text="Próximo"
                android:backgroundTint="@color/table_header"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- TELA 2: MATRIZ FATURAMENTO X MARGEM -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical">

             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="Matriz de Venda x Margem"
                 android:textSize="18sp"
                 android:textStyle="bold"
                 android:textColor="#000000"
                 android:layout_marginBottom="16dp"
                 android:layout_gravity="center_horizontal"/>

            <LinearLayout
                android:id="@+id/layoutLoadingMatriz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aguarde, consultando..."
                    android:layout_marginTop="8dp"
                    android:textColor="#000000"/>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/scrollMatriz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:background="#FFFFFF">

                    <!-- Linha 1: 34% -->
                    <TableRow>
                        <TextView
                            android:id="@+id/cell_34_200k"
                            android:text="R$ 200,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row_alt"/>
                        <TextView
                            android:id="@+id/cell_34_250k"
                            android:text="R$ 300,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row_alt"/>
                        <TextView
                            android:id="@+id/cell_34_300k"
                            android:text="R$ 600,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row_alt"/>
                        <TextView
                            android:id="@+id/lbl_row_34"
                            android:text="34%"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"/>
                    </TableRow>

                    <!-- Linha 2: 33% -->
                    <TableRow>
                        <TextView
                            android:id="@+id/cell_33_200k"
                            android:text="R$ 100,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row_alt"/>
                        <TextView
                            android:id="@+id/cell_33_250k"
                            android:text="R$ 200,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row_alt"/>
                        <TextView
                            android:id="@+id/cell_33_300k"
                            android:text="R$ 300,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row_alt"/>
                        <TextView
                            android:id="@+id/lbl_row_33"
                            android:text="33%"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"/>
                    </TableRow>

                    <!-- Linha 3: 32% -->
                    <TableRow>
                        <TextView
                            android:id="@+id/cell_32_200k"
                            android:text="R$ 0,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row_alt"/>
                        <TextView
                            android:id="@+id/cell_32_250k"
                            android:text="R$ 100,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row_alt"/>
                        <TextView
                            android:id="@+id/cell_32_300k"
                            android:text="R$ 200,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"
                            android:background="@color/table_row_alt"/>
                        <TextView
                            android:id="@+id/lbl_row_32"
                            android:text="32%"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_margin="1dp"/>
                    </TableRow>

                    <!-- Linha 4: Rodapé Valores -->
                    <TableRow>
                        <TextView
                            android:id="@+id/footer_200k"
                            android:text="R$ 200.000,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="10dp"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:layout_margin="1dp"/>
                        <TextView
                            android:id="@+id/footer_250k"
                            android:text="R$ 250.000,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="10dp"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:layout_margin="1dp"/>
                        <TextView
                            android:id="@+id/footer_300k"
                            android:text="R$ 300.000,00"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="10dp"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:layout_margin="1dp"/>
                        <TextView
                            android:text=""
                            android:layout_margin="1dp"/>
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:text="Vendas Líquidas X Margem"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:padding="10dp"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:layout_span="3"
                            android:layout_margin="1dp"/>
                    </TableRow>

                </TableLayout>
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnAnterior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voltar"
                android:backgroundTint="@color/table_header"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ViewFlipper>
    </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/metasOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/viewDimVendaDia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/painelVendaDia"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginTop="-14dp"
            android:layout_marginBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="252dp"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dia Atual"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDataVendaDiaOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hoje"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Venda Líquida"
                    android:textColor="#666666"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtVendaLiquidaDiaOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="R$ 0,00"
                    android:textColor="#14C35A"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutLoadingVendaDiaOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Atualizando valor..."
                        android:textColor="#666666"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtStatusVendaDiaOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Puxe a etiqueta para abrir ou fechar."
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Esse valor sempre mostra o dia atual, sem depender do período selecionado acima."
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/etiquetaVendaDia"
                android:layout_width="22dp"
                android:layout_height="168dp"
                android:layout_gravity="center_vertical"
                android:background="@color/table_header"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/imgEtiquetaVendaDia"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="H&#10;O&#10;J&#10;E"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
