<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginEnd="5dp"
    android:background="@color/ligthgrayline"
    android:orientation="vertical">


    <LinearLayout


        android:id="@+id/linearLayout8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <TextView

            android:id="@+id/adp_filial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANTONIO SALES"
            android:textAlignment="textStart"
            android:textSize="13sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/adp_previsao"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:gravity="left"
            android:text="Previsão de chegada 29/09/2018"
            android:textColor="#158745"
            android:textSize="9sp"
            android:textStyle="bold"

            />


    </LinearLayout>


    <LinearLayout


        android:id="@+id/linearLayout14"
        android:layout_width="68sp"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginStart="3dp"
        android:layout_marginTop="3dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout8">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|top"
            android:layout_marginTop="2sp"
            android:text="ESTOQUE"
            android:textSize="9sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/adp_disponivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginTop="2sp"
            android:text="10000.000"
            android:textSize="14sp"
            android:textStyle="bold"

            />


    </LinearLayout>

    <LinearLayout


        android:id="@+id/linearLayout17"
        android:layout_width="55sp"
        android:layout_height="0dp"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="3dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/linearLayout14"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout8">

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:text="FÍSICO"
            android:textSize="9sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/adp_fisico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:layout_marginTop="2sp"
            android:text="20000.00"
            android:textSize="11sp"

            />

    </LinearLayout>

    <LinearLayout


        android:id="@+id/linearLayout20"
        android:layout_width="55sp"
        android:layout_height="0dp"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="3dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/linearLayout17"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout8">


        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:text="RESERVA"
            android:textSize="9sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/adp_reserva"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:layout_marginTop="2sp"
            android:text="190.00"
            android:textAlignment="center"
            android:textSize="11sp"

            />

    </LinearLayout>

    <LinearLayout


        android:id="@+id/linearLayout22"
        android:layout_width="55sp"
        android:layout_height="0dp"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="3dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/linearLayout20"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout8">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:text="TRÂNSITO"
            android:textSize="9sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/adp_transito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:layout_marginTop="2sp"
            android:text="0"
            android:textSize="11sp"

            />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/linearLayout18"
        android:layout_width="55sp"
        android:layout_height="0dp"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="3dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/linearLayout22"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout8">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:text="FUTURO"
            android:textSize="9sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/adp_futuro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:layout_marginTop="2sp"
            android:text="200.00"
            android:textSize="11sp"

            />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout21"
        android:layout_width="60sp"
        android:layout_height="0dp"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="3dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/linearLayout18"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout8">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:text="MOSTRUÁRIO"
            android:textSize="9sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/adp_mostruario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center"
            android:layout_marginTop="2sp"
            android:text="200.00"
            android:textSize="11sp"

            />


    </LinearLayout>


    <LinearLayout
        android:id="@+id/linearLayout13"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/linearLayout8"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/lote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            />

        <ImageView
            android:id="@+id/ponta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>











