<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:fancy="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/ligthgrayline"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <TextView
        android:id="@+id/textoEntrega"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Para consultar o status da entrega de um pedido, aperte na lupa e informe o número do pedido ou o cgccpf do cliente."
        android:textAlignment="center"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <mehdi.sakout.fancybuttons.FancyButton
        android:id="@+id/btn_entregadia"
        android:layout_width="150dp"
        android:layout_height="25dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="top"
        app:layout_constraintBottom_toTopOf="@+id/listaEntregas"
        app:layout_constraintEnd_toStartOf="@+id/btn_entregaatraso"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textoEntrega"
        fancy:fb_borderColor="#8A18D1"
        fancy:fb_borderWidth="2dp"
        fancy:fb_defaultColor="#ffff"
        fancy:fb_focusColor="#8A18D1"
        fancy:fb_radius="30dp"
        fancy:fb_text="Entregas do dia"
        fancy:fb_textColor="#8A18D1"
        fancy:fb_textSize="12sp" />

    <mehdi.sakout.fancybuttons.FancyButton
        android:id="@+id/btn_entregaatraso"
        android:layout_width="150dp"
        android:layout_height="25dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="top"
        app:layout_constraintBottom_toTopOf="@+id/listaEntregas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_entregadia"
        app:layout_constraintTop_toBottomOf="@+id/textoEntrega"
        app:layout_constraintVertical_bias="0.0"
        fancy:fb_borderColor="#8A18D1"
        fancy:fb_borderWidth="2dp"
        fancy:fb_defaultColor="#ffff"
        fancy:fb_focusColor="#8A18D1"
        fancy:fb_radius="30dp"
        fancy:fb_text="Entregas do mês"
        fancy:fb_textColor="#8A18D1"
        fancy:fb_textSize="12sp" />

    <ListView

        android:id="@+id/listaEntregas"
        android:background="@color/ligthgrayline"
        android:layout_width="360dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_entregadia">

    </ListView>

    <TextView
        android:id="@+id/adp_ent_qtd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:paddingRight="6dp"
        android:text=""
        android:textAlignment="viewEnd"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/listaEntregas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_entregaatraso" />


</androidx.constraintlayout.widget.ConstraintLayout>