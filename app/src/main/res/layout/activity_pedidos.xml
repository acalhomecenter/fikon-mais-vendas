<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:fancy="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PedidosActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/ped_appbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/ped_status_bar_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/primary_dark" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/ped_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/AppTheme.PopupOverlay"
            app:titleTextColor="@android:color/white"
            app:subtitleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>


    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ped_appbar">

        <LinearLayout
            android:id="@+id/ped_ind_lib"
            android:clickable="true"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@color/green_trans"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Liberado"
                android:textAlignment="center"
                android:textColor="@color/icons"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/ped_txtLibCxa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="3"
                android:textAlignment="center"
                android:textColor="@color/icons"
                android:textSize="25sp"
                android:textStyle="bold" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ped_ind_parc"
            android:clickable="true"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@color/pinktrans"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Parcial"
                android:textAlignment="center"
                android:textColor="@color/icons"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/ped_txtParcial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="2"
                android:textAlignment="center"
                android:textColor="@color/icons"
                android:textSize="25sp"
                android:textStyle="bold" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ped_ind_fat"
            android:clickable="true"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@color/primary_dark_trans"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Faturados"
                android:textAlignment="center"
                android:textColor="@color/icons"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/ped_txtConcluidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="10"
                android:textAlignment="center"
                android:textColor="@color/icons"
                android:textSize="25sp"
                android:textStyle="bold" />


        </LinearLayout>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/backgroudlist"
        android:elevation="4dp"
        fancy:layout_constraintBottom_toBottomOf="parent"
        fancy:layout_constraintEnd_toEndOf="parent"
        fancy:layout_constraintStart_toStartOf="parent"
        fancy:layout_constraintTop_toBottomOf="@+id/ped_ind_flib">


        <mehdi.sakout.fancybuttons.FancyButton
            android:id="@+id/ped_btn_dia"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="25dp"
            android:gravity="top"
            fancy:fb_borderColor="#2196f3"
            fancy:fb_borderWidth="2dp"
            fancy:fb_defaultColor="#ffff"
            fancy:fb_focusColor="#2196f3"
            fancy:fb_radius="30dp"
            fancy:fb_text="Dia"
            fancy:fb_textColor="#2196f3"
            fancy:fb_textSize="12sp"
            fancy:layout_constraintStart_toStartOf="parent"
            fancy:layout_constraintTop_toTopOf="parent" />

        <mehdi.sakout.fancybuttons.FancyButton
            android:id="@+id/ped_btn_mes"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="10dp"
            android:gravity="top"
            fancy:fb_borderColor="#2196f3"
            fancy:fb_borderWidth="2dp"
            fancy:fb_defaultColor="#ffff"
            fancy:fb_focusColor="#2196f3"
            fancy:fb_radius="30dp"
            fancy:fb_text="Mês"
            fancy:fb_textColor="#2196f3"
            fancy:fb_textSize="12sp"
            fancy:layout_constraintEnd_toStartOf="@+id/ped_btn_periodo"
            fancy:layout_constraintStart_toEndOf="@+id/ped_btn_dia"
            fancy:layout_constraintTop_toTopOf="parent" />


        <mehdi.sakout.fancybuttons.FancyButton
            android:id="@+id/ped_btn_periodo"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="10dp"
            android:gravity="top"
            fancy:fb_borderColor="#2196f3"
            fancy:fb_borderWidth="2dp"
            fancy:fb_defaultColor="#ffff"
            fancy:fb_focusColor="#2196f3"
            fancy:fb_radius="30dp"
            fancy:fb_text="Período"
            fancy:fb_textColor="#2196f3"
            fancy:fb_textSize="12sp"
            fancy:layout_constraintEnd_toEndOf="parent"
            fancy:layout_constraintTop_toTopOf="parent" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ped_lista_pedido"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            fancy:layout_constraintHorizontal_bias="0.0"
            fancy:layout_constraintTop_toBottomOf="@+id/ped_btn_mes">

        </androidx.recyclerview.widget.RecyclerView>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ped_btn_flutuante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        fancy:fabSize="mini"
        android:elevation="6dp"
        android:src="@drawable/ic_flutuante_orc"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/ped_ind_flib"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:text=""
        android:textColor="@color/primary_text"
        fancy:layout_constraintEnd_toStartOf="@+id/ped_ind_pcaixa"
        fancy:layout_constraintHorizontal_chainStyle="spread_inside"
        fancy:layout_constraintStart_toStartOf="parent"
        fancy:layout_constraintTop_toBottomOf="@+id/linearLayout2" />

    <TextView
        android:id="@+id/ped_ind_pcaixa"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/laranja"
        android:textAlignment="viewEnd"
        android:text=""
        fancy:layout_constraintEnd_toEndOf="parent"
        fancy:layout_constraintStart_toEndOf="@+id/ped_ind_flib"
        fancy:layout_constraintTop_toBottomOf="@+id/linearLayout2" />


</androidx.constraintlayout.widget.ConstraintLayout>
