<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/icons"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        >


        <TextView
            android:id="@+id/adp_pro_codigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            android:text="164788"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageView
            android:id="@+id/adp_pro_imagem"
            android:layout_width="46dp"
            android:layout_height="0dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"
            android:scaleType="centerInside"
            android:src="@drawable/semimagem"
            app:layout_constraintBottom_toTopOf="@+id/adp_pro_margem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/adp_pro_codigo" />


        <TextView
            android:id="@+id/adp_pro_descricao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:paddingLeft="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="ARGAM ACII 15KG COLAMIX REJUNTAMIX "
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/adp_pro_linha"
            app:layout_constraintEnd_toStartOf="@+id/adp_pro_imgSelecao"
            app:layout_constraintStart_toEndOf="@+id/adp_pro_codigo"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/adp_pro_linha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:paddingLeft="5dp"
            android:paddingTop="4dp"
            android:text="LINHA: ARGAMASSA E IMPERMEABILIZANTES "
            android:textSize="9sp"
            app:layout_constraintEnd_toStartOf="@+id/adp_pro_comissao_val"
            app:layout_constraintStart_toEndOf="@+id/adp_pro_imagem"
            app:layout_constraintTop_toBottomOf="@+id/adp_pro_descricao" />

        <TextView
            android:id="@+id/adp_pro_comprador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="5dp"
            android:paddingLeft="5dp"
            android:paddingTop="4dp"
            android:text="COMPRADOR: PRACIANO "
            android:textSize="9sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/adp_pro_imagem"
            app:layout_constraintTop_toBottomOf="@+id/adp_pro_fornecedor"
            app:layout_constraintVertical_bias="0.0" />


        <TextView
            android:id="@+id/adp_pro_fornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:paddingLeft="5dp"
            android:paddingTop="4dp"
            android:text="FORNECEDOR: REJUNTAMIX "
            android:textSize="9sp"
            app:layout_constraintEnd_toStartOf="@+id/adp_pro_preco"
            app:layout_constraintStart_toEndOf="@+id/adp_pro_imagem"
            app:layout_constraintTop_toBottomOf="@+id/adp_pro_linha" />


        <TextView
            android:id="@+id/adp_pro_preco_de"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="De: R$ 30,90"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintBaseline_toBaselineOf="@+id/adp_pro_preco"
            app:layout_constraintEnd_toStartOf="@+id/adp_pro_preco"
            app:layout_constraintStart_toEndOf="@+id/adp_pro_imagem" />

        <TextView
            android:id="@+id/adp_pro_preco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="2"
            android:gravity="right"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="1dp"
            android:text="R$: 10,90"
            android:textSize="22sp"
            app:layout_constraintTop_toBottomOf="@+id/adp_pro_comissao_val"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/adp_pro_un" />

        <TextView
            android:id="@+id/adp_pro_un"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="10dp"
            android:gravity="left"
            android:paddingTop="8dp"
            android:paddingRight="5dp"
            android:text="UN"
            android:textSize="9sp"
            app:layout_constraintTop_toBottomOf="@+id/adp_pro_comissao_val"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/adp_pro_imgSelecao"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_img_selecao"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/adp_pro_imgAcelerado"
            app:layout_constraintTop_toTopOf="parent"></ImageView>

        <ImageView
            android:id="@+id/adp_pro_imgAcelerado"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="3dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_img_acelerado"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/adp_pro_margem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:text=""
            android:textSize="9sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/adp_pro_comprador"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/adp_pro_imagem"
            app:layout_constraintVertical_bias="1.0" />

        <TextView
            android:id="@+id/adp_pro_comissao_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="2dp"
            android:text="Premiação:"
            android:textSize="9sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/adp_pro_preco"
            app:layout_constraintEnd_toStartOf="@+id/adp_pro_comissao_val" />

        <TextView
            android:id="@+id/adp_pro_comissao_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="2dp"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textAlignment="viewEnd"
            android:textStyle="bold"
            android:textSize="9sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/adp_pro_descricao"
            app:layout_constraintBottom_toTopOf="@+id/adp_pro_preco"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
