<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar.Bridge">
        <!-- Identidade visual compartilhada (redesign) -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/icons</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Fikon.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Fikon.Medium</item>
        <item name="materialButtonStyle">@style/Widget.Fikon.Button</item>
        <item name="cardViewStyle">@style/Widget.Fikon.CardView</item>
        <item name="android:textColorHint">@color/secondary_text</item>

        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="windowActionBarOverlay">false</item>
        <item name="android:windowActionBarOverlay">false</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:colorControlNormal">@color/secondary_text</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:icon">@color/icons</item>
        <item name="android:colorButtonNormal" tools:targetApi="lollipop">@color/primary_dark</item>
        <item name="android:divider">@color/divider</item>


    </style>


